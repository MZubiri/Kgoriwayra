# ==============================================================================
# Cabalgatas Kgoriwayra - Environment Configuration Template
# ==============================================================================

# --- Base de Datos (MySQL 8.0) ---
MYSQL_ROOT_PASSWORD=change_this_root_password_in_production
MYSQL_DATABASE=kgoriwayra
MYSQL_USER=kgoriwayra_user
MYSQL_PASSWORD=change_this_user_password_in_production
MYSQL_PORT=3306

# --- Backend API (ASP.NET Core 9) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=kgoriwayra;User=kgoriwayra_user;Password=change_this_user_password_in_production;

# --- JWT Authentication ---
Jwt__Secret=change_this_super_secret_jwt_key_with_at_least_32_characters_long_12345
Jwt__Issuer=api.cabalgataskgoriwayra.com
Jwt__Audience=cabalgataskgoriwayra.com
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# --- Seed Admin User ---
Admin__Username=admin
Admin__Email=admin@cabalgataskgoriwayra.com
Admin__Password=ChangeMe123!*

# --- SMTP / Email Notifications ---
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__User=notifications@cabalgataskgoriwayra.com
Smtp__Password=smtp_secret_password
Smtp__FromEmail=reservas@cabalgataskgoriwayra.com
Smtp__FromName=Cabalgatas Kgoriwayra
Smtp__EnableSsl=true

# --- Uploads & Media ---
Upload__Path=/app/uploads
Upload__MaxSizeMB=10
Upload__AllowedExtensions=.jpg,.jpeg,.png,.webp,.avif

# --- CORS ---
Cors__AllowedOrigins=http://localhost:4200,http://localhost:4000,https://cabalgataskgoriwayra.com,https://www.cabalgataskgoriwayra.com

# --- Frontend (Angular) ---
API_URL=http://localhost:8080
DEFAULT_LANGUAGE=es
WHATSAPP_PHONE=51995800077
